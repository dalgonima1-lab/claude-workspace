# Claude API 키. platform.claude.com → API Keys 에서 발급. 절대 저장소에 커밋하지 않는다.
ANTHROPIC_API_KEY=
# 폰 앱과 서버가 공유하는 비밀 토큰. 길고 무작위한 문자열로 직접 정한다. (예: openssl rand -hex 32)
APP_SHARED_TOKEN=
# 선택. 기본값 claude-opus-5-5. 비용을 줄일 때 claude-haiku-5-5 로 바꾼다.
CLAUDE_MODEL=claude-opus-5-5
# 선택. low | medium | high | xhigh | max. 기본값 high.
CLAUDE_EFFORT=high
